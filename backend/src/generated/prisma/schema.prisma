generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DuoStatus {
  PENDING
  ACTIVE
  REJECTED
  ENDED
}

enum HabitFrequency {
  DAILY
}

enum NotificationType {
  CHECKIN_CREATED
  POKE_RECEIVED
  DUO_INVITATION
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  avatarUrl    String?
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  duoMemberships DuoMember[]
  checkIns       CheckIn[]
  notifications  Notification[]

  sentPokes     Poke[] @relation("SentPokes")
  receivedPokes Poke[] @relation("ReceivedPokes")

  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Duo {
  id        String    @id @default(cuid())
  status    DuoStatus @default(PENDING)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  members DuoMember[]
  habits  Habit[]
}

model DuoMember {
  duoId    String
  userId   String
  joinedAt DateTime @default(now())

  duo  Duo  @relation(fields: [duoId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([duoId, userId])
}

model Habit {
  id          String         @id @default(cuid())
  duoId       String
  name        String
  description String?
  frequency   HabitFrequency @default(DAILY)
  deadline    String?
  startDate   DateTime
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  duo      Duo       @relation(fields: [duoId], references: [id], onDelete: Cascade)
  checkIns CheckIn[]
  pokes    Poke[]
}

model CheckIn {
  id        String   @id @default(cuid())
  habitId   String
  userId    String
  date      DateTime
  photoUrl  String?
  note      String?
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, userId, date])
  @@index([habitId, date])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  payload   Json
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model Poke {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  habitId    String
  createdAt  DateTime @default(now())

  fromUser User  @relation("SentPokes", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User  @relation("ReceivedPokes", fields: [toUserId], references: [id], onDelete: Cascade)
  habit    Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([toUserId, createdAt])
}
